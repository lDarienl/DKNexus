// 1. Demostración de Recursividad y Scope
print("--- Calculando Factorial (Recursión) ---");

function factorial(n) {
    if (n <= 1) {
        retornar 1;
    }
    // Llamada recursiva
    retornar n * factorial(n - 1);
}

// Variable global
resultado = factorial(500);
print("El factorial de 500 es:");
print(resultado);

print("--- Estado de la memoria ---");
// Si agregaste dump_memory(), esto demostrará que la memoria se limpió correctamente
dump_memory();
