// --- PASO 2 ML: Regresion Lineal por Descenso de Gradiente ---
// Enfoque iterativo (estilo SGDRegressor / Grokking Deep Learning).
// El motor nativo dknumpy actualiza los pesos: w = w - lr * grad.

print("--- Entrenando Regresion Lineal ---");

// Dataset de juguete: relacion ideal y = 0 + 2*x
X = [1.0, 2.0, 3.0, 4.0];
Y = [2.0, 4.0, 6.0, 8.0];

// Pesos: W[0] = bias/intercepto, W[1] = pendiente
W = [0.0, 0.0];

// Hiperparametros
lr = 0.01;
epochs = 50;

n = len(X);

for (epoca = 0; epoca < epochs; epoca = epoca + 1) {
    // Gradientes acumulados: grad[0] = bias, grad[1] = pendiente
    grad = [0.0, 0.0];

    for (i = 0; i < n; i = i + 1) {
        pred = W[0] + W[1] * X[i];
        error = pred - Y[i];
        grad[0] = grad[0] + error;
        grad[1] = grad[1] + error * X[i];
    }

    // Actualizacion nativa de pesos por descenso de gradiente
    W = update_weights(W, grad, lr);
}

print("Pesos finales encontrados (W[0]=bias, W[1]=pendiente):");
print(W);

// Predicciones finales
Y_pred = [];
for (i = 0; i < n; i = i + 1) {
    push(Y_pred, W[0] + W[1] * X[i]);
}

print("Error final (MSE):");
print(mse(Y, Y_pred));

print("Resultado en el canvas:");
graficar_linea(X, Y, W);
