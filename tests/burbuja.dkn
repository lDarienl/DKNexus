function burbuja(lista) {
    n = len(lista);
    for (i = 0; i <= n - 1; i = i + 1) {
        for (j = 0; j <= n - i - 2; j = j + 1) {
            if (lista[j] > lista[j + 1]) {
                temp = lista[j];
                lista[j] = lista[j + 1];
                lista[j + 1] = temp;
            }
        }
    }
    return lista;
}

L = [64, 34, 25, 12, 22, 11, 90];
print("Ordenando...");
print(burbuja(L));
