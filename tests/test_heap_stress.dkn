print("--- TEST DE HEAP DINAMICO (DKNumpy + bloques contiguos en C) ---");

// El heap ya NO esta limitado rigidamente a 1024 slots: crece de forma
// dinamica para soportar vectores y matrices grandes (Machine Learning).

// 1. Construir una matriz grande de forma incremental (lista de filas).
m_grande = [];
for (i = 0; i < 32; i = i + 1) {
    fila = [];
    for (j = 0; j < 32; j = j + 1) {
        push(fila, 1);
    }
    push(m_grande, fila);
}
print("Matriz 32x32 creada sin error (heap dinamico).");

// 2. Una matriz literal se aplana en un BLOQUE CONTIGUO reservado en C.
//    En dump_memory() aparece su puntero (@bloque_C=0x...).
M = [[1, 2, 3], [4, 5, 6]];
P = [[1, 0], [0, 1], [1, 1]];
print("Producto M * P (multiplicacion delegada a C):");
print(M * P);

dump_memory();
