function factorial(n) {
    res = 1;
    for (i = 2; i <= n; i = i + 1) {
        res = res * i;
    }
    return res;
}

function exponencial_taylor(x, n) {
    suma = 0;
    for (i = 0; i <= n; i = i + 1) {
        termino = (x ^ i) / factorial(i);
        suma = suma + termino;
    }
    return suma;
}

// Prueba: e^1 con 10 iteraciones (Cercano a 2.71828)
print("Aproximacion de e^1:");
print(exponencial_taylor(1, 10));
