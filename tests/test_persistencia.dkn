// --- PERSISTENCIA ULTRA-LIVIANA (Redis con fallback a disco) ---
print("Backend de persistencia activo:");
print(store_backend());

// Guardar el estado de los pesos de un modelo de ML.
redis_set("modelo_pesos", [0.5, -0.2, 0.13]);
redis_set("hiperparams", {"lr": 0.01, "epochs": 100});
redis_set("nombre_modelo", "perceptron_v1");

print("Pesos recuperados:");
pesos = redis_get("modelo_pesos");
print(pesos);
print(pesos[0]);

print("Hiperparametros recuperados:");
hp = redis_get("hiperparams");
print(hp["lr"]);

print("Existe 'modelo_pesos'?");
print(redis_exists("modelo_pesos"));

print("Claves almacenadas:");
print(redis_keys());

print("Borrar 'nombre_modelo':");
print(redis_del("nombre_modelo"));
print(redis_exists("nombre_modelo"));
