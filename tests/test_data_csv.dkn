// ====================================================================
//  PROCESAMIENTO DE data.csv  (~10 280 registros, columnas mixtas)
//
//  Columnas: id, edad, nivel_edu, ingreso_mensual, sex, anios_esc
//  NOTA: load_csv() solo acepta numeros puros; este archivo tiene
//        comillas, encabezado y texto -> usar read_csv().
//
//  Ejecutar desde src/:  python interpreterDKN.py  ->  ../tests/test_data_csv.dkn
// ====================================================================

print("============================================================");
print(" 1) LECTURA DEL ARCHIVO tests/data.csv");
print("============================================================");

tabla = read_csv("../tests/data.csv");

print("Filas de datos (sin encabezado):");
print(tabla["n_rows"]);
print("Columnas:");
print(tabla["n_cols"]);
print("Nombres de columnas (header):");
print(tabla["header"]);

print("");
print("============================================================");
print(" 2) ESTADISTICAS sobre ingreso_mensual (columna indice 3)");
print("============================================================");

ingresos = csv_col_num(tabla, 3);
print("Registros con ingreso numerico:");
print(len(ingresos));
print("Ingreso promedio:");
print(mean(ingresos));
print("Ingreso minimo:");
print(min(ingresos));
print("Ingreso maximo:");
print(max(ingresos));

edades = csv_col_num(tabla, 1);
print("Edad promedio:");
print(mean(edades));

print("");
print("============================================================");
print(" 3) MUESTRA para graficos y ML (primeros 100 registros)");
print("============================================================");

n_muestra = 100;
X_edad = [];
Y_ingreso = [];
for (i = 0; i < n_muestra; i = i + 1) {
    push(X_edad, edades[i]);
    push(Y_ingreso, ingresos[i]);
}

print("Dispersion: edad vs ingreso_mensual (muestra 100):");
graficar_dispersion(X_edad, Y_ingreso);

print("");
print("============================================================");
print(" 4) REGRESION LINEAL  edad -> ingreso (datos normalizados)");
print("============================================================");

// Normalizar evita explosión del gradiente (ingresos hasta ~81000).
Xn = normalize(X_edad);
Yn = normalize(Y_ingreso);

W = [0.0, 0.0];
lr = 0.01;

for (epoca = 0; epoca < 200; epoca = epoca + 1) {
    grad = [0.0, 0.0];
    for (i = 0; i < n_muestra; i = i + 1) {
        pred = W[0] + W[1] * Xn[i];
        err = pred - Yn[i];
        grad[0] = grad[0] + err;
        grad[1] = grad[1] + err * Xn[i];
    }
    W = update_weights(W, grad, lr);
}

print("Pesos en escala normalizada [bias, pendiente]:");
print(W);

Y_pred = [];
for (i = 0; i < n_muestra; i = i + 1) {
    push(Y_pred, W[0] + W[1] * Xn[i]);
}
print("MSE en escala normalizada (debe ser bajo):");
print(mse(Yn, Y_pred));

print("Grafico: edad normalizada vs ingreso normalizado + recta:");
graficar_linea(Xn, Yn, W);

print("");
print("============================================================");
print(" 5) K-MEANS en (edad, ingreso) normalizados - muestra 200");
print("============================================================");

n_km = 200;
pts_edad = [];
pts_ing = [];
for (i = 0; i < n_km; i = i + 1) {
    push(pts_edad, edades[i]);
    push(pts_ing, ingresos[i]);
}
edad_n = normalize(pts_edad);
ing_n = normalize(pts_ing);

X_2d = [];
for (i = 0; i < n_km; i = i + 1) {
    push(X_2d, [edad_n[i], ing_n[i]]);
}

etiquetas = kmeans(X_2d, 3, 15);
print("Etiquetas de cluster (muestra 200, k=3):");
print(etiquetas);

print("Dispersion: edad normalizada vs etiqueta de cluster:");
graficar_dispersion(edad_n, etiquetas);

print("");
print("=== data.csv procesado correctamente ===");
