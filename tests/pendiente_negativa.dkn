X = [1.0, 2.0, 3.0, 4.0];
Y = [10.0, 8.0, 6.0, 4.0];
W = [0.0, 0.0];
for (epoca = 0; epoca < 150; epoca = epoca + 1) {
    g = [0.0, 0.0];
    for (i = 0; i < 4; i = i + 1) {
        err = (W[0] + W[1] * X[i]) - Y[i];
        g[0] = g[0] + err;
        g[1] = g[1] + err * X[i];
    }
    W = update_weights(W, g, 0.01);
}
print("Pesos de la pendiente negativa:");
print(W);
graficar_linea(X, Y, W);
